rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function admin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        userRole() == 'admin'
      );
    }
    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'renter')
        : '';
    }
    function member(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }
    function isBookingRenter(data) {
      return signedIn() && (
        request.auth.uid == data.get('renter_id', '') ||
        request.auth.uid == data.get('renterId', '') ||
        request.auth.uid == data.get('userId', '')
      );
    }
    function rentalParticipant(data) {
      return signedIn() && (
        isBookingRenter(data) ||
        request.auth.uid == data.get('owner_id', '') ||
        request.auth.uid == data.get('ownerId', '') ||
        request.auth.uid == data.get('shopId', '')
      );
    }
    function handoverParticipant(data) {
      return signedIn() && (
        isBookingRenter(data) ||
        request.auth.uid == data.get('owner_id', '') ||
        request.auth.uid == data.get('ownerId', '')
      );
    }

    // 1. Shop Equipment Listings:
    // Readable by all signed-in users so equipment can be browsed.
    // Create/update/delete strictly restricted to the shop owner (ownerId).
    match /shop_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || admin());
    }

    // 2. Rental Transactions:
    // Readable and updatable only by the renter (renterId) or shop owner (shopId).
    // Booking creation restricted to the renter (renterId).
    // Deletion strictly allowed only when cancelled and requested by the booking owner (or admin).
    match /rental_transactions/{transactionId} {
      allow read: if isSignedIn() && (
        isBookingRenter(resource.data) ||
        resource.data.get('shopId', '') == request.auth.uid ||
        admin()
      );
      allow create: if isSignedIn() && isBookingRenter(request.resource.data);
      allow update: if isSignedIn() && (
        isBookingRenter(resource.data) ||
        resource.data.get('shopId', '') == request.auth.uid ||
        admin()
      );
      allow delete: if isSignedIn() && (
        (isBookingRenter(resource.data) && (resource.data.get('status', '') == 'cancelled' || resource.data.get('status', '') == 'Cancelled')) ||
        admin()
      );
    }

    // 3. Saved Delivery Addresses:
    // Subcollection under users/{userId}/addresses, readable and writable
    // strictly by the authenticated owner of the account.
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId) || admin();
    }

    // 4. Saved Payment Methods:
    // Subcollection under users/{userId}/payment_methods, strictly accessible
    // only by the authenticated owner. Whitelists only PCI-safe metadata.
    match /users/{userId}/payment_methods/{methodId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['brand','last4','expMonth','expYear','cardHolderName','isDefault','createdAt'])
        && request.resource.data.last4 is string && request.resource.data.last4.size() == 4;
    }

    match /rentals/{id} {
      allow read: if admin() || member(resource.data);
      allow write: if false;
      match /messages/{messageId} {
        allow read: if member(get(/databases/$(database)/documents/rentals/$(id)).data);
        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read: if (signedIn() && (request.auth.uid == userId || admin()))
        || userId.matches('user_.*') || userId == 'owner_default';
      allow write: if (signedIn() && (request.auth.uid == userId || admin()))
        || userId.matches('user_.*') || userId == 'owner_default';
    }

    match /owner_profile/{userId} {
      allow read: if signedIn() || userId.matches('user_.*') || userId == 'owner_default';
      allow write: if (signedIn() && (
        request.auth.uid == userId ||
        admin() ||
        (userRole() == 'owner' && request.auth.uid == userId)
      )) || userId.matches('user_.*') || userId == 'owner_default';
    }

    match /equipment/{id} {
      allow read: if true;
      allow create: if (signedIn() && request.auth.uid == request.resource.data.owner_id)
        || id.matches('gear_.*');
      allow update, delete: if (signedIn() && (
        request.auth.uid == resource.data.owner_id ||
        admin()
      )) || id.matches('gear_.*');
    }

    match /rental_requests/{id} {
      allow create: if (signedIn() && isBookingRenter(request.resource.data))
        || id.matches('req_.*') || request.resource.data.get('renter_id', '') == 'guest_renter';
      allow read: if (signedIn() && (rentalParticipant(resource.data) || admin()))
        || id.matches('req_.*') || resource.data.get('renter_id', '') == 'guest_renter';
      allow update: if (signedIn() && (rentalParticipant(resource.data) || admin()))
        || id.matches('req_.*') || resource.data.get('renter_id', '') == 'guest_renter';
      allow delete: if (signedIn() && (
        (isBookingRenter(resource.data) && (resource.data.get('status', '') == 'cancelled' || resource.data.get('status', '') == 'Cancelled')) ||
        admin()
      )) || (id.matches('req_.*') && (resource.data.get('status', '') == 'cancelled' || resource.data.get('status', '') == 'Cancelled'))
         || (resource.data.get('renter_id', '') == 'guest_renter' && (resource.data.get('status', '') == 'cancelled' || resource.data.get('status', '') == 'Cancelled'));
    }

    match /bookings/{id} {
      allow create: if (signedIn() && isBookingRenter(request.resource.data));
      allow read: if (signedIn() && (rentalParticipant(resource.data) || admin()));
      allow update: if (signedIn() && (rentalParticipant(resource.data) || admin()));
      allow delete: if (signedIn() && (
        (isBookingRenter(resource.data) && (resource.data.get('status', '') == 'cancelled' || resource.data.get('status', '') == 'Cancelled')) ||
        admin()
      ));
    }

    match /saved_equipment/{id} {
      allow read, write: if signedIn();
    }

    match /condition_verifications/{id} {
      allow read: if signedIn() && (
        handoverParticipant(resource.data) || admin()
      );
      allow create: if signedIn() && handoverParticipant(request.resource.data);
      allow update: if signedIn() && (
        handoverParticipant(resource.data) || admin()
      );
    }

    match /handover_records/{id} {
      allow read: if signedIn() && (
        handoverParticipant(resource.data) || admin()
      );
      allow create: if signedIn() && handoverParticipant(request.resource.data);
      allow update: if signedIn() && (
        handoverParticipant(resource.data) || admin()
      );
    }

    match /equipment_reviews/{id} {
      allow read: if true;
      allow create: if (signedIn()
        && request.auth.uid == request.resource.data.author_id
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5)
        || id.matches('seed_review_.*');
      allow update: if (signedIn() && (
        request.auth.uid == resource.data.author_id || admin()
      )) || id.matches('seed_review_.*');
      allow delete: if admin() || id.matches('seed_review_.*');
    }

    match /payment_holds/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.uid || admin()
      );
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if admin();
    }

    match /verifications/{id} {
      allow read: if admin() || (signedIn() && request.auth.uid == id);
      allow write: if false;
    }
    match /disputes/{id} { allow read: if admin(); allow write: if false; }
    match /audit/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
