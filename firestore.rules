rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function member(data) { return signedIn() && request.auth.uid in data.participantIds; }
    match /rentals/{id} {
      allow read: if admin() || member(resource.data);
      // Server commands validate relationships, evidence and state transitions.
      allow write: if false;
      match /messages/{messageId} {
        allow read: if member(get(/databases/$(database)/documents/rentals/$(id)).data);
        allow write: if false;
      }
    }
    match /verifications/{id} { allow read: if admin(); allow write: if false; }
    match /disputes/{id} { allow read: if admin(); allow write: if false; }
    match /audit/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
